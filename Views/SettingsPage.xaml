<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="SettingsPageRoot"
    x:Class="voltrex_light.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:voltrex_light.Models"
    xmlns:viewmodels="using:voltrex_light.ViewModels"
    xmlns:converters="using:voltrex_light.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,24" Spacing="24" MaxWidth="920" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Customize application appearance, visualization defaults, unit formats, and scan history."
                           Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Preferences Section -->
            <StackPanel Spacing="10">
                <TextBlock Text="Preferences &amp; Display" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="18,16">
                    <StackPanel Spacing="18">
                        <!-- Application Theme -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Application Theme" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Choose Light, Dark, or automatically match your Windows system preference."
                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ComboBox Grid.Column="1" Width="180" VerticalAlignment="Center"
                                      ItemsSource="{x:Bind ViewModel.AvailableThemes}"
                                      SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <!-- Default Visualization -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Default Visualization" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Preferred visualizer mode loaded upon completing volume and directory scans."
                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ComboBox Grid.Column="1" Width="180" VerticalAlignment="Center"
                                      ItemsSource="{x:Bind ViewModel.AvailableVisualizations}"
                                      SelectedItem="{x:Bind ViewModel.SelectedVisualization, Mode=TwoWay}" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <!-- Size Display Units -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Size Unit Convention" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Standard decimal notation (KB, MB, GB, TB) or IEC binary notation (KiB, MiB, GiB, TiB)."
                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ComboBox Grid.Column="1" Width="180" VerticalAlignment="Center"
                                      ItemsSource="{x:Bind ViewModel.AvailableSizeUnits}"
                                      SelectedItem="{x:Bind ViewModel.SelectedSizeUnit, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Scan History Section -->
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Scan History &amp; Diagnostics" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearHistoryCommand}"
                            Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTipService.ToolTip="Clear all recorded scan history entries">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock Text="Clear History" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <StackPanel Spacing="10">
                        <ListView ItemsSource="{x:Bind ViewModel.HistoryItems, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  MaxHeight="260" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ScanHistoryItem">
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xEDA2;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind RootPath}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FormattedTimestamp}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="10" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusBadge}" Style="{ThemeResource CaptionTextBlockStyle}" FontSize="10" />
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{x:Bind FormattedTotalBytes}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" />

                                        <TextBlock Grid.Column="4" Text="{x:Bind TotalFilesCount}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                                    HorizontalAlignment="Center" Spacing="8" Margin="0,16,0,16">
                            <FontIcon Glyph="&#xE81C;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No previous scans recorded" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Recent scan summaries will appear here as you analyze disks and folders."
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- About Voltrex Light Section -->
            <StackPanel Spacing="10">
                <TextBlock Text="About Voltrex Light" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="18,18">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="10">
                                <Image Source="ms-appx:///Assets/voltrex_light_logo.png" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Voltrex Light" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="18" />
                                <TextBlock Text="developed by mohomed Ziard | Voltrex Digital" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="High-performance native Windows disk space analyzer &amp; visualization suite. Engineered natively with .NET 8, WinUI 3, Windows App SDK, and modern Windows 11 Fluent Design."
                                   Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <StackPanel Spacing="8" Margin="0,4,0,0">
                            <Grid>
                                <TextBlock Text="Developer" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="mohomed Ziard | Voltrex Digital" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Administrator Access" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="Full Administrator (UAC Enabled)" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Version" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.AppVersion}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Architecture" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Architecture}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Runtime Framework" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FrameworkVersion}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Operating System" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.OsVersion}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Windows 11 Visual Effects" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="Mica Alt Translucent Material Active" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
