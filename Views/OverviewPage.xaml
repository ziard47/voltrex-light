<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="OverviewPageRoot"
    x:Class="voltrex_light.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:voltrex_light.Models"
    xmlns:viewmodels="using:voltrex_light.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    SizeChanged="OnPageSizeChanged">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="28,24,28,32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page Header Area with Direct Actions -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Storage Overview" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" FontSize="26" />
                    <TextBlock Text="Local disks, storage volume health, and system capacity distribution." 
                               Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                </StackPanel>

                <!-- Header Quick Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ScanFolderQuickCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="12,6" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F4;" FontSize="13" />
                            <TextBlock Text="Scan Folder" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.LoadDrivesCommand}" Style="{ThemeResource DefaultButtonStyle}" Padding="10,6" CornerRadius="6"
                            ToolTipService.ToolTip="Refresh storage drive volumes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Refresh" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Storage Metrics Cards Adaptive Grid -->
            <Grid x:Name="MetricsGrid" Grid.Row="1" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Total Storage -->
                <Border x:Name="CardTotal" Grid.Row="0" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Total Capacity" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Width="28" Height="28" CornerRadius="6" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                                <FontIcon Glyph="&#xEDA2;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.FormattedTotalCapacity, Mode=OneWay}" FontSize="24" FontWeight="Bold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Aggregated across all connected drives" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Used Storage -->
                <Border x:Name="CardUsed" Grid.Row="0" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Used Space" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Width="28" Height="28" CornerRadius="6" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.FormattedTotalUsed, Mode=OneWay}" FontSize="24" FontWeight="Bold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.FormattedOverallPercentUsed, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" HorizontalAlignment="Left" />
                            <ProgressBar Value="{x:Bind ViewModel.OverallPercentUsed, Mode=OneWay}" Maximum="100" Width="70" Height="4" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Free Storage -->
                <Border x:Name="CardFree" Grid.Row="0" Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Available Free" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Width="28" Height="28" CornerRadius="6" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.FormattedTotalFree, Mode=OneWay}" FontSize="24" FontWeight="Bold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Ready for system and file allocation" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Volumes Online -->
                <Border x:Name="CardActions" Grid.Row="0" Grid.Column="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Storage Volumes" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Width="28" Height="28" CornerRadius="6" Background="{ThemeResource LayerFillColorAltBrush}">
                                <FontIcon Glyph="&#xEC42;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Drives.Count, Mode=OneWay}" FontSize="24" FontWeight="Bold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Drives Active" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="All volumes ready for depth scanning" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Section Title & Status -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Available Storage Volumes" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="16" />
                    <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Drives.Count, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" FontSize="11" />
                    </Border>
                </StackPanel>

                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" VerticalAlignment="Center" />
            </Grid>

            <!-- Drives List / Error State -->
            <Grid Grid.Row="3">
                <!-- Error Banner if any -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" Title="Drive Discovery Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Margin="0,0,0,12" />

                <!-- Empty State -->
                <StackPanel Visibility="{x:Bind ViewModel.HasDrives, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,40,0,40">
                    <FontIcon Glyph="&#xEDA2;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No storage volumes detected" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <Button Content="Refresh Drives" Command="{x:Bind ViewModel.LoadDrivesCommand}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Drives Grid / Items -->
                <ListView ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="IsSelected" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DriveItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18,16">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Icon, Drive Name / Format, and Action Buttons -->
                                    <Grid Grid.Row="0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Drive Glyph in Refined Fluent Badge -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>

                                        <!-- Name, Volume Label and Type Badges -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="15"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4" Padding="6,1.5">
                                                    <TextBlock Text="{x:Bind DriveFormat}" Style="{ThemeResource CaptionTextBlockStyle}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{x:Bind DriveTypeDescription}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions: Open in Explorer & Analyze Button -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Style="{ThemeResource SubtleButtonStyle}" VerticalAlignment="Center"
                                                    CornerRadius="6" Padding="8,6"
                                                    Command="{Binding ElementName=OverviewPageRoot, Path=ViewModel.OpenInExplorerCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    ToolTipService.ToolTip="Open drive in Windows Explorer">
                                                <FontIcon Glyph="&#xED25;" FontSize="13" />
                                            </Button>

                                            <Button Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center"
                                                    CornerRadius="6" Padding="14,6"
                                                    Command="{Binding ElementName=OverviewPageRoot, Path=ViewModel.ScanDriveCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    ToolTipService.ToolTip="Analyze disk space usage">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ProgressRing Visibility="{x:Bind IsScanning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                  IsActive="{x:Bind IsScanning, Mode=OneWay}" Width="12" Height="12" Foreground="White" />
                                                    <FontIcon Glyph="&#xE768;" FontSize="11"
                                                              Visibility="{x:Bind IsScanning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                                    <TextBlock Text="{x:Bind AnalyzeButtonText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bottom Row: Capacity Bar & Metrics -->
                                    <StackPanel Grid.Row="1" Spacing="7">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind FormattedUsedSize}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="used of" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                                <TextBlock Text="{x:Bind FormattedTotalSize}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind FormattedFreeSize}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="free" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                                <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="2,0" />
                                                <TextBlock Text="{x:Bind FormattedPercentUsed}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Usage Progress Bar with dynamic color -->
                                        <ProgressBar Value="{x:Bind PercentUsed}" Maximum="100" Height="6" CornerRadius="3"
                                                     Foreground="{x:Bind PercentUsed, Converter={StaticResource UsageToColorConverter}}" />

                                        <Grid>
                                            <TextBlock Text="{x:Bind RootDirectory}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{x:Bind LastScanTimeFormatted, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

