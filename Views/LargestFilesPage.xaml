<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="LargestFilesPageRoot"
    x:Class="voltrex_light.Views.LargestFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:voltrex_light.Models"
    xmlns:viewmodels="using:voltrex_light.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,20,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="3">
                <TextBlock Text="Largest Files" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.CurrentScopeDescription, Mode=OneWay}" 
                           Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Quick Action Toolbar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.OpenFileCommand}" ToolTipService.ToolTip="Open with default Windows app">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                        <TextBlock Text="Open File" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.OpenInExplorerCommand}" ToolTipService.ToolTip="Reveal in Windows Explorer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEC50;" FontSize="13" />
                        <TextBlock Text="Open in Explorer" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.NavigateToFolderCommand}" ToolTipService.ToolTip="Explore containing directory in Folder Analysis">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                        <TextBlock Text="Go to Folder" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Partial Scan Warning Notice (if applicable) -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsPartialScan, Mode=OneWay}"
                 Severity="Warning"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.PartialScanNotice, Mode=OneWay}" />

        <!-- Search & Filter Bar (Harmonized Heights & Baselines) -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid ColumnSpacing="12" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Labels -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Search" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Category" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Min Size" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Sort by" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Row 1: Unified Inputs & Controls -->
                <!-- Search Box -->
                <TextBox Grid.Row="1" Grid.Column="0" Height="32" VerticalAlignment="Center"
                         PlaceholderText="Search by name, extension or path..." 
                         Text="{x:Bind ViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Category Filter -->
                <ComboBox Grid.Row="1" Grid.Column="1" Height="32" VerticalAlignment="Center"
                          ItemsSource="{x:Bind ViewModel.AvailableCategories}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                          MinWidth="130" />

                <!-- Size Threshold Filter -->
                <ComboBox Grid.Row="1" Grid.Column="2" Height="32" VerticalAlignment="Center"
                          ItemsSource="{x:Bind ViewModel.AvailableSizeFilters}"
                          SelectedItem="{x:Bind ViewModel.SelectedSizeFilter, Mode=TwoWay}"
                          MinWidth="110" />

                <!-- Sorting -->
                <ComboBox Grid.Row="1" Grid.Column="3" Height="32" VerticalAlignment="Center"
                          ItemsSource="{x:Bind ViewModel.AvailableSorts}"
                          SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                          MinWidth="170" />

                <!-- Clear Filters Button -->
                <Button Grid.Row="1" Grid.Column="4" Height="32" VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ClearFiltersCommand}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        CornerRadius="4" Padding="10,0"
                        ToolTipService.ToolTip="Reset all filters and sorting">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE894;" FontSize="11" />
                        <TextBlock Text="Clear" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Status / Counts -->
                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Displaying:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Files.Count, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="of" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.TotalScannedFiles, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="files" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Table -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="3.5*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="File Name" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Type" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Directory Path" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Size" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="% of Largest" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Last Modified" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Empty State -->
                <StackPanel Grid.Row="1"
                            Visibility="{x:Bind ViewModel.HasFilteredFiles, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="20">
                    <FontIcon Glyph="&#xE8A5;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No Files To Display" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.NoResultsMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
                    <Button Command="{x:Bind ViewModel.ClearFiltersCommand}" Content="Reset Filters" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <!-- Files List -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                          DoubleTapped="OnItemDoubleTapped"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileSystemNode">
                            <Grid ColumnSpacing="12" Padding="6,6">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Open File" Click="OnContextMenuOpenFile">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8E5;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open in Windows Explorer" Click="OnContextMenuOpenExplorer">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEC50;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Go to Containing Folder" Click="OnContextMenuGoToFolder">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED25;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="3.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <!-- File Name & Icon -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Extension / Type Badge -->
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Extension}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <!-- Path -->
                                <TextBlock Grid.Column="2" Text="{x:Bind FullPath}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                <!-- Size -->
                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />

                                <!-- % of Largest with Progress bar -->
                                <Grid Grid.Column="4" VerticalAlignment="Center" Margin="8,0">
                                    <ProgressBar Value="{x:Bind PercentOfParent}" Maximum="100" Height="5" CornerRadius="2.5"
                                                 Foreground="{x:Bind PercentOfParent, Converter={StaticResource UsageToColorConverter}}" />
                                    <TextBlock Text="{x:Bind FormattedPercent}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-13,0,0" />
                                </Grid>

                                <!-- Modified -->
                                <TextBlock Grid.Column="5" Text="{x:Bind FormattedLastModified}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           TextAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>

