<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="FolderAnalysisPageRoot"
    x:Class="voltrex_light.Views.FolderAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:voltrex_light.Models"
    xmlns:viewmodels="using:voltrex_light.ViewModels"
    xmlns:viscontrols="using:voltrex_light.Visualizations.Controls"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Subheader & Path Bar -->
        <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Target Folder:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentFolderPath, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Filter Box -->
                <TextBox Grid.Column="1" PlaceholderText="Filter items by name..." Width="280" HorizontalAlignment="Right"
                         Text="{x:Bind ViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.OpenInExplorerCommand}" ToolTipService.ToolTip="Open selected item in Windows Explorer">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEC50;" FontSize="13" />
                            <TextBlock Text="Open in Explorer" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <DropDownButton ToolTipService.ToolTip="Export scan report to CSV or JSON" IsEnabled="{x:Bind ViewModel.HasData, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                            <TextBlock Text="Export" FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Export to CSV (.csv)..." Command="{x:Bind ViewModel.ExportCsvCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE9F9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export to JSON (.json)..." Command="{x:Bind ViewModel.ExportJsonCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE943;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Warning / Incomplete Scan Notice Bar -->
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}"
                 Severity="Warning"
                 Title="Incomplete Scan Notice"
                 Message="{x:Bind ViewModel.WarningsSummary, Mode=OneWay}"
                 Margin="16,8,16,0" />

        <!-- Main Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="340" />
                <ColumnDefinition Width="2.5*" MinWidth="260" />
                <ColumnDefinition Width="1.8*" MinWidth="220" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Folder Tree & Size Table -->
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Interactive Table Column Headers for Sorting -->
                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.6*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0,4" HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Name">
                                <TextBlock Text="Name" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            </Button>

                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0,4" HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Size">
                                <TextBlock Text="Size" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Right" />
                            </Button>

                            <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0,4" HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Percent">
                                <TextBlock Text="% Parent" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Center" />
                            </Button>

                            <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0,4" HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Files">
                                <TextBlock Text="Files" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Right" />
                            </Button>

                            <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0,4" HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Modified">
                                <TextBlock Text="Last Modified" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Right" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Empty State when no data -->
                    <StackPanel Grid.Row="1"
                                Visibility="{x:Bind ViewModel.HasData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="20">
                        <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No folder analysis active" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Click 'Scan Folder' on the top toolbar to choose any local folder and analyze space distribution."
                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280" />
                    </StackPanel>

                    <!-- Table Rows -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.DisplayNodes, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileSystemNode">
                                <Grid ColumnSpacing="8" Padding="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Name with Glyph -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedSize}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />

                                    <!-- % of Parent with mini bar -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                        <ProgressBar Value="{x:Bind PercentOfParent}" Maximum="100" Height="4" CornerRadius="2"
                                                     Foreground="{x:Bind PercentOfParent, Converter={StaticResource UsageToColorConverter}}" />
                                        <TextBlock Text="{x:Bind FormattedPercent}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-12,0,0" />
                                    </Grid>

                                    <!-- File Count -->
                                    <TextBlock Grid.Column="3" Text="{x:Bind FormattedFileCount}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <!-- Last Modified -->
                                    <TextBlock Grid.Column="4" Text="{x:Bind FormattedLastModified}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Column 2: Central Interactive Visualization Area (Sunburst & Treemap) -->
            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <viscontrols:DiskSpaceVisualizerControl x:Name="SpaceVisualizer"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        ItemSelected="SpaceVisualizer_ItemSelected" />
            </Border>

            <!-- Column 3: Contextual Details Panel -->
            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16">
                <Grid>
                    <StackPanel Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No item selected" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        <TextBlock Text="Select a subfolder or file from the list to view disk properties."
                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="180" />
                    </StackPanel>

                    <ScrollViewer Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Item Properties" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="Bold" />

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{x:Bind ViewModel.SelectedNode.IconGlyph, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedNode.Name, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNode.FormattedSize, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Full Path" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNode.FullPath, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Percentage of Parent" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNode.FormattedPercent, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Files Contained" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNode.FormattedFileCount, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Subdirectories" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNode.FormattedSubfolderCount, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Last Modified" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNode.FormattedLastModified, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <Button Command="{x:Bind ViewModel.OpenInExplorerCommand}" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC50;" FontSize="13" />
                                    <TextBlock Text="Reveal in Explorer" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="Folder Analysis Workspace" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Folder Size:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalSizeFormatted, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Total Files:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalFilesFormatted, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Scan Time:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedElapsedTime, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Skipped:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SkippedItemsCount, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Ready" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>

