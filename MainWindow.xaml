<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="voltrex_light.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:voltrex_light"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Voltrex Light — Storage &amp; Disk-Space Analyzer">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Modern Windows 11 Titlebar -->
        <Border x:Name="AppTitleBar" Grid.Row="0"
                Height="44"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Section: Branding & Admin Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- App Logo Icon -->
                    <Border Width="24" Height="24" CornerRadius="6">
                        <Image Source="ms-appx:///Assets/voltrex_light_logo.png" Stretch="UniformToFill" />
                    </Border>

                    <!-- Title & Attribution -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Voltrex Light" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" FontSize="13" />

                        <!-- Elevated Administrator Status Badge -->
                        <Border Visibility="{x:Bind ViewModel.AdminBadgeVisibility, Mode=OneWay}"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Running with elevated Windows Administrator privileges">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7EF;" FontSize="9" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Admin" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Request Elevation Button (Visible when NOT running as Administrator) -->
                        <Button Visibility="{x:Bind ViewModel.ElevateButtonVisibility, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ElevateAdminCommand}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Padding="5,2" VerticalAlignment="Center" CornerRadius="4"
                                ToolTipService.ToolTip="Relaunch Voltrex Light as Administrator for complete disk access">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7EF;" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="Run as Admin" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        
                    </StackPanel>
                </StackPanel>

                <!-- Center Flexible Spacer & Active Scanning Pill -->
                <Grid Grid.Column="1" Background="Transparent">
                    <Border Visibility="{x:Bind ViewModel.ScanningVisibility, Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="12,3"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing IsActive="True" Width="13" Height="13" />
                            <TextBlock Text="Scanning" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ScanStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Command="{x:Bind ViewModel.CancelScanCommand}" Style="{ThemeResource SubtleButtonStyle}" Padding="3,1" CornerRadius="4" ToolTipService.ToolTip="Cancel current scan">
                                <FontIcon Glyph="&#xE711;" FontSize="9" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Dedicated Spacer for System Caption Buttons (Minimize, Maximize, Close) -->
                <Border Grid.Column="2" x:Name="CaptionButtonsSpacer" Width="140" Background="Transparent" />
            </Grid>
        </Border>

        <!-- Global Indeterminate Scan Progress Bar -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                     Visibility="{x:Bind ViewModel.ScanningVisibility, Mode=OneWay}" />

        <!-- Navigation View with Compact Width & Adaptive Mode -->
        <NavigationView Grid.Row="2" x:Name="MainNavView"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="220"
                        CompactPaneLength="48"
                        CompactModeThresholdWidth="641"
                        ExpandedModeThresholdWidth="1008"
                        Background="Transparent"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="MainNavView_SelectionChanged"
                        Loaded="MainNavView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA40;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Storage Analysis" Tag="StorageAnalysis">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Visibility="{x:Bind ViewModel.ScanningVisibility, Mode=OneWay}"
                                   Style="{ThemeResource AttentionIconInfoBadgeStyle}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Largest Files" Tag="LargestFiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Storage Drives Section Header -->
                <NavigationViewItemHeader x:Name="DrivesSectionHeader" Content="STORAGE DRIVES" />

                <!-- Dynamic Drive Items will be populated in code-behind -->
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="0" Background="Transparent" />
        </NavigationView>
    </Grid>
</Window>
