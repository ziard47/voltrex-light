<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="voltrex_light.Visualizations.Controls.DiskSpaceVisualizerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:voltrex_light.Visualizations.Controls"
    xmlns:vismodels="using:voltrex_light.Visualizations.Models"
    xmlns:converters="using:voltrex_light.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Visualization Header: Breadcrumbs & Controls Toolbar -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Controls & Full Breadcrumbs Trail -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Reset to Root Button -->
                    <Button x:Name="RootButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="7,4"
                            CornerRadius="4"
                            ToolTipService.ToolTip="Return to root directory (Home)"
                            Click="RootButton_Click"
                            IsEnabled="False">
                        <FontIcon Glyph="&#xE80F;" FontSize="13" />
                    </Button>

                    <!-- Navigate Up (Parent) Button -->
                    <Button x:Name="UpButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="7,4"
                            CornerRadius="4"
                            ToolTipService.ToolTip="Navigate up to parent folder (Up)"
                            Click="UpButton_Click"
                            IsEnabled="False">
                        <FontIcon Glyph="&#xE70E;" FontSize="13" />
                    </Button>

                    <Border Height="18" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" />

                    <!-- Breadcrumbs Trail with Horizontal Scroll Support -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalAlignment="Center">
                        <ItemsControl x:Name="BreadcrumbsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vismodels:VisualizationBreadcrumbItem">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE76C;" FontSize="9"
                                                  Visibility="{x:Bind ShowSeparator, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0" />
                                        <Button Content="{x:Bind Name}"
                                                Tag="{x:Bind}"
                                                Click="BreadcrumbButton_Click"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                Padding="5,2"
                                                CornerRadius="4"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                ToolTipService.ToolTip="{x:Bind FullPath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Visualization Options & Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Depth Selector -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Depth:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="DepthComboBox"
                                  Width="70"
                                  SelectedIndex="2"
                                  SelectionChanged="DepthComboBox_SelectionChanged">
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Labels Toggle -->
                    <ToggleButton x:Name="LabelsToggle"
                                  IsChecked="True"
                                  Padding="6,4"
                                  ToolTipService.ToolTip="Show or hide labels"
                                  Click="LabelsToggle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8D2;" FontSize="11" />
                            <TextBlock Text="Labels" FontSize="11" />
                        </StackPanel>
                    </ToggleButton>

                    <Border Height="18" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                    <!-- Mode Toggle: Sunburst vs Treemap (Centered Alignment) -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <RadioButton x:Name="SunburstModeRadio"
                                     GroupName="VisMode"
                                     IsChecked="True"
                                     Checked="ViewMode_Checked"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Padding="6,0,0,0">
                            <TextBlock Text="Sunburst" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0" />
                        </RadioButton>
                        <RadioButton x:Name="TreemapModeRadio"
                                     GroupName="VisMode"
                                     Checked="ViewMode_Checked"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Padding="6,0,0,0">
                            <TextBlock Text="Treemap" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0" />
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Visualization Canvas Area -->
        <Grid Grid.Row="1">
            <!-- Sunburst View -->
            <controls:SunburstControl x:Name="SunburstView"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Visibility="Visible"
                                      ItemSelected="OnVisualizationItemSelected"
                                      DrillDownRequested="OnVisualizationDrillDown"
                                      NavigateUpRequested="OnVisualizationNavigateUp" />

            <!-- Treemap View -->
            <controls:TreemapControl x:Name="TreemapView"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Visibility="Collapsed"
                                     ItemSelected="OnVisualizationItemSelected"
                                     DrillDownRequested="OnVisualizationDrillDown" />
        </Grid>
    </Grid>
</UserControl>
